# Cloud ingestion configuration
#
# Set these through the deployment environment or managed secret store. This file
# documents names only; it contains no credentials or project-specific values.
GOOGLE_CLOUD_PROJECT=your-project-id
# Cloud Functions use application-default credentials / workload identity. Do not
# commit service-account JSON or access tokens.
# The ingestion buckets are derived at runtime as data-<project-number> and
# archive-<project-number>; BigQuery dataset is stocks.

# Required only by the financial-report extraction functions. Supply this through
# a managed secret, never in source control.
OPENROUTER_API_KEY=replace-with-managed-secret
