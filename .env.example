# Cloud ingestion configuration. Runtime code reads only the process
# environment; placeholders below are not deployable credentials or targets.
TRADVISOR_RUNTIME_TARGET=ingestion
TRADVISOR_ENVIRONMENT=development
GOOGLE_CLOUD_PROJECT=replace-with-project-id
TRADVISOR_TARGET_PROJECT_ID=replace-with-the-same-project-id
TRADVISOR_ENVIRONMENT_PROJECT_ID=replace-with-the-project-authorized-for-this-environment
TRADVISOR_INGESTION_SERVICE_ACCOUNT=replace-with-service-account@replace-with-project-id.iam.gserviceaccount.com
TRADVISOR_INGESTION_DATA_BUCKET=replace-with-data-bucket
TRADVISOR_INGESTION_ARCHIVE_BUCKET=replace-with-archive-bucket
TRADVISOR_INGESTION_DATASET=stocks
TRADVISOR_INGESTION_SHARES_TABLE=replace-with-project-id.stocks.shares
TRADVISOR_INGESTION_DIVIDENDS_TABLE=replace-with-project-id.stocks.dividends
TRADVISOR_INGESTION_FINANCIALS_TABLE=replace-with-project-id.stocks.financials
TRADVISOR_INGESTION_RATINGS_TABLE=replace-with-project-id.stocks.ratings

# Cloud Functions use workload identity. Do not commit service-account JSON or
# access tokens. Source endpoints are explicitly checked in config.yml and are
# validated before any source request.

# Required only by the financial-report extraction functions. Supply this through
# a managed secret, never in source control.
OPENROUTER_API_KEY=replace-with-managed-secret
