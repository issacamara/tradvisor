# Secret-free reference only. Runtime code reads process environment; it does
# not load this file. Do not replace the cursor-secret placeholder with a value.
TRADVISOR_RUNTIME_TARGET=api
TRADVISOR_ENVIRONMENT=development
GOOGLE_CLOUD_PROJECT=replace-with-project-id
TRADVISOR_TARGET_PROJECT_ID=replace-with-the-same-project-id
TRADVISOR_ENVIRONMENT_PROJECT_ID=replace-with-the-project-authorized-for-this-environment
GOOGLE_CLOUD_FIRESTORE_DATABASE=(default)
TRADVISOR_SERVING_TARGET=firestore
FIRESTORE_CURSOR_SECRET=

# API target
TRADVISOR_CORS_ORIGINS=http://localhost:3000
WORKFLOW_REGION=replace-with-region
MARKET_DATA_TABLE=replace-with-project-id.dataset.table
TRADVISOR_RECOVERY_BUCKET=replace-with-bucket-name

# Daily job target
FINANCIALS_TABLE=replace-with-project-id.dataset.table

# Publication control target (positive, bounded release debounce in seconds)
TRADVISOR_PUBLICATION_DEBOUNCE_SECONDS=60

# Admin commands must load RuntimeConfiguration with target="admin" and use
# the same explicit environment/project target before invoking domain actions.
